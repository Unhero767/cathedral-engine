; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.
; Strata: Books I–XL (Cathedral-Engine Master Architecture)

config_version=5

[application]

config/name="CathedralEngine"
config/description="Cathedral-Engine Godot 4.x Client for Chamber V Spatial Telemetry & Resonance Shaders"
config/version="1.0.0"
run/main_scene="res://godot_client/ChamberV.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

CathedralSync="*res://godot_client/CathedralSync.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.04, 0.04, 0.07, 1)
textures/canvas_textures/default_texture_filter=0
