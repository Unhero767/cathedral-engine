; Engine configuration file.
[application]

config/name="Chamber-01: The Oculus"
config/description="Cathedral-Engine Path Beta 60-Second Interactive Room"
run/main_scene="res://scenes/rooms/Chamber01_Oculus.tscn"
config/features=PackedStringArray("4.3", "Forward Plus", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false

