    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
            const target = document.getElementById('tab-' + tabId);
            if (target) target.classList.add('active');
            event.currentTarget.classList.add('active');
            if (tabId === 'viewport') init3D();
            if (tabId === 'qgrav') drawQGravLattice();
        }

        async function triggerFrameTick() {
            const res = await fetch('/api/eas03');
            const data = await res.json();
            document.getElementById('frame-log').innerText = JSON.stringify(data, null, 2);
        }

        async function runEASBenchmark() {
            document.getElementById('eas-log').innerText = "Running 60-frame stress harness...";
            const res = await fetch('/api/eas03?frames=60');
            const data = await res.json();
            document.getElementById('eas-log').innerText = JSON.stringify(data, null, 2);
        }

        async function calcPhysics() {
            const res = await fetch('/api/physics');
            const data = await res.json();
            document.getElementById('physics-log').innerText = JSON.stringify(data, null, 2);
            document.getElementById('omega-display').innerText = data.awareness_index || '0.05768';
        }

        async function drawArcana() {
            const res = await fetch('/api/arcana');
            const data = await res.json();
            document.getElementById('arcana-log').innerText = JSON.stringify(data, null, 2);
        }

        async function runMonteCarlo() {
            const res = await fetch('/api/arcana?monte_carlo=1');
            const data = await res.json();
            document.getElementById('mc-log').innerText = JSON.stringify(data, null, 2);
        }

        async function triggerCombatTurn() {
            const res = await fetch('/api/combat');
            const data = await res.json();
            document.getElementById('combat-log').innerText = JSON.stringify(data, null, 2);
        }

        async function runQGravStep() {
            document.getElementById('qgrav-log').innerText = "Solving Schrödinger-Newton Split-Step Fourier lattice...";
            const res = await fetch('/api/qgrav?action=step&steps=5');
            const data = await res.json();
            document.getElementById('qgrav-log').innerText = JSON.stringify(data, null, 2);
            document.getElementById('qgrav-energy').innerText = data.total_self_energy.toExponential(3) + " J";
            document.getElementById('qgrav-strain').innerText = data.max_medium_strain.toExponential(3);
            drawQGravLattice();
        }

        async function runDPEval() {
            document.getElementById('qgrav-log').innerText = "Evaluating Diósi-Penrose Gravitational Self-Decoherence...";
            const res = await fetch('/api/qgrav?action=diosi_penrose&dx=1e-14');
            const data = await res.json();
            document.getElementById('qgrav-log').innerText = JSON.stringify(data, null, 2);
            document.getElementById('qgrav-tau').innerText = data.tau_decay_seconds.toExponential(3) + " s";
        }

        async function runFunctorEval() {
            document.getElementById('qgrav-log').innerText = "Evaluating QGrav Category Functor S Fixed Point...";
            const res = await fetch('/api/qgrav?action=functor');
            const data = await res.json();
            document.getElementById('qgrav-log').innerText = JSON.stringify(data, null, 2);
        }

        function drawQGravLattice() {
            const canvas = document.getElementById('qgrav-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;
            ctx.fillStyle = '#05070a';
            ctx.fillRect(0, 0, w, h);

            // Draw radial wavepacket intensity map and strain field contour
            const cx = w / 2;
            const cy = h / 2;
            const rad = Math.min(w, h) * 0.4;

            const grad = ctx.createRadialGradient(cx, cy, 2, cx, cy, rad);
            grad.addColorStop(0, 'rgba(0, 229, 255, 0.9)');
            grad.addColorStop(0.3, 'rgba(212, 175, 55, 0.7)');
            grad.addColorStop(0.7, 'rgba(65, 105, 225, 0.3)');
            grad.addColorStop(1, 'rgba(5, 7, 10, 0)');

            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.arc(cx, cy, rad, 0, Math.PI * 2);
            ctx.fill();

            // Draw concentric strain contour rings
            ctx.strokeStyle = 'rgba(212, 175, 55, 0.4)';
            ctx.lineWidth = 1.5;
            for (let r = 15; r < rad; r += 20) {
                ctx.beginPath();
                ctx.arc(cx, cy, r, 0, Math.PI * 2);
                ctx.stroke();
            }

            ctx.fillStyle = '#94a3b8';
            ctx.font = '11px monospace';
            ctx.fillText('Soliton Center |ψ(r)|² peak', 15, 25);
            ctx.fillText('Strain Gradient ∇ε(r) concentric rings', 15, 42);
        }

        async function loadCodex() {
            try {
                const res = await fetch('/api/codex');
                const data = await res.json();
                const tbody = document.getElementById('codex-tbody');
                tbody.innerHTML = '';
                data.books.forEach(b => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `<td><strong>${b.label}</strong></td><td>${b.filename}</td><td>${b.size_bytes} B</td>`;
                    tbody.appendChild(tr);
                });
                document.getElementById('book-count').innerText = data.books.length;
            } catch(e){}
        }
        loadCodex();

        let renderer, scene, camera, mesh;
        function init3D() {
            const container = document.getElementById('three-canvas');
            if (renderer) return;
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(60, container.clientWidth / container.clientHeight, 0.1, 1000);
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            container.appendChild(renderer.domElement);

            const geometry = new THREE.TorusKnotGeometry(10, 3, 100, 16);
            const material = new THREE.MeshBasicMaterial({ color: 0xd4af37, wireframe: true });
            mesh = new THREE.Mesh(geometry, material);
            scene.add(mesh);
            camera.position.z = 30;

            function animate() {
                requestAnimationFrame(animate);
                mesh.rotation.x += 0.01;
                mesh.rotation.y += 0.015;
                renderer.render(scene, camera);
            }
            animate();
        }
    </script>
</body>
</html>
"""

    

    def handle_interaction(self, params):
        action = params.get("action", "EXAMINE")
        target_uid = params.get("target_uid", "unknown")
        x = int(params.get("x", 2))
        y = int(params.get("y", 4))
        spectrum = params.get("spectrum", "Blue")

        if action in ("EXAMINE_CONSTRUCT", "EXAMINE"):
            return {
                "status": "CONSTRUCT_EXAMINED",
                "target_uid": target_uid,
                "coordinates": {"x": x, "y": y},
                "resonance_hz": 65.4,
                "state": "UNLOCKED_AEROSTATIC_CORE",
                "description": "Massive aerostatic manifold column humming at 65.4 Hz (Blue Constant). Dampeners standing by for alignment."
            }
        elif action in ("ENGAGE_COLUMN_REGULATOR", "ENGAGE"):
            if hasattr(self, "action_log"):
                self.action_log.append(f"[CONSTRUCT] Aerostatic Manifold {target_uid} calibrated to 65.4 Hz.")
            return {
                "status": "AEROSTATIC_COLUMN_ENGAGED",
                "target_uid": target_uid,
                "duct_pressure_psi": 14.7,
                "damping_ratio": 1.0,
                "resonance_phase": "SYNCHRONIZED_65.4_HZ",
                "carrier_hz": 65.4,
                "insight_reward": 80,
                "corridor_east": "PRESSURIZED",
                "terminal_strata_blue": "ACCESSIBLE"
            }
        return {
            "status": "INTERACTION_RECORDED",
            "action": action,
            "target_uid": target_uid
        }


class CathedralHTTPHandler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)

        # 1. Altar UI Root
        if path in ["/", "/index.html"]:
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(HTML_ALTAR_TEMPLATE.encode("utf-8"))
            return

        # 2. Master Cosmic Atlas
        elif path in ["/atlas", "/universe_atlas.html"]:
            atlas_path = os.path.join(BASE_DIR, "static", "universe_atlas.html")
            if os.path.exists(atlas_path):
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                with open(atlas_path, "rb") as f:
                    self.wfile.write(f.read())
                return

        # 3. Playable RPG Client
        elif path in ["/rpg", "/rpg_client.html"]:
            rpg_path = os.path.join(BASE_DIR, "static", "rpg_client.html")
            if os.path.exists(rpg_path):
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                with open(rpg_path, "rb") as f:
                    self.wfile.write(f.read())
                return

        # 4. Arcade & Flight Simulator
        elif path in ["/arcade", "/cosmo_catch.html"]:
            arcade_path = os.path.join(BASE_DIR, "static", "cosmo_catch.html")
            if os.path.exists(arcade_path):
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                with open(arcade_path, "rb") as f:
                    self.wfile.write(f.read())
                return

        # 5. Dialetheic Dashboard
        elif path in ["/dashboard", "/dialetheic_dashboard.html"]:
            dash_path = os.path.join(BASE_DIR, "static", "dialetheic_dashboard.html")
            if os.path.exists(dash_path):
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                with open(dash_path, "rb") as f:
                    self.wfile.write(f.read())
                return

        # 6. Core API Endpoints
        elif path == "/api/status":
            codex_mgr = CodexManager(BASE_DIR)
            books = codex_mgr.list_books()
            camp = CampaignEngine(os.path.join(BASE_DIR, "strata", "campaign.db"))
            data = {
                "status": "ONLINE",
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "carrier_hz": 43.7,
                "anchor": "Olney, IL (37.7306° N, -88.0817° W)",
                "book_count": len(books),
                "party": camp.get_party(),
                "qgrav_self_energy": QGRAV_ENGINE.component.total_self_energy
            }
            self._send_json(data)
            return

        elif path == "/api/qgrav":
            action = query.get("action", ["telemetry"])[0]
            if action == "step":
                dt = float(query.get("dt", [1.0e-18])[0])
                steps = int(query.get("steps", [1])[0])
                res = QGRAV_ENGINE.step_simulation(dt=dt, steps=steps)
                self._send_json(res)
            elif action == "diosi_penrose":
                dx_val = float(query.get("dx", [1.0e-14])[0])
                res = QGRAV_ENGINE.calculate_diosi_penrose_decoherence(dx_val)
                self._send_json(res)
            elif action == "functor":
                res = QGRAV_ENGINE.evaluate_qgrav_functor()
                self._send_json(res)
            elif action == "state":
                self._send_json(QGRAV_ENGINE.export_lattice_state())
            else:
                self._send_json({
                    "status": "ONLINE",
                    "grid_size": QGRAV_ENGINE.grid_size,
                    "dx": QGRAV_ENGINE.dx,
                    "mass": QGRAV_ENGINE.mass,
                    "total_self_energy": QGRAV_ENGINE.component.total_self_energy,
                    "max_medium_strain": max(QGRAV_ENGINE.component.strain_field),
                    "diosi_penrose": QGRAV_ENGINE.calculate_diosi_penrose_decoherence(1.0e-14),
                    "qgrav_functor": QGRAV_ENGINE.evaluate_qgrav_functor()
                })
            return

        elif path == "/api/rpg/atlas":
            self._send_json(UNIVERSE_ATLAS.universe_data)
            return

        elif path == "/api/eas03":
            engine = EAS03ParaconsistentEngine(os.path.join(BASE_DIR, "strata", "prime_ledger.ndjson"))
            if "frames" in query:
                frames = int(query["frames"][0])
                data = engine.run_harness(frames)
            else:
                data = engine.process_frame_tick(random.randint(1, 10000))
            self._send_json(data)
            return

        elif path == "/api/physics":
            engine = EmotionalPhysicsEngine()
            manifest_path = os.path.join(os.path.dirname(BASE_DIR), "mlaos-emotional-physics", "manifest", "aurelia_9_state.json")
            if os.path.exists(manifest_path):
                data = engine.evaluate_manifest(manifest_path)
            else:
                theta, _ = engine.calculate_kinetic_state(0.95, 0.81)
                hc = engine.calculate_harmonization_constant(0.95, 0.81)
                omega = engine.calculate_awareness_index(hc, 0.95)
                data = {"theta_e": theta, "harmonization_constant": hc, "awareness_index": omega}
            self._send_json(data)
            return

        elif path == "/api/arcana":
            arcana = ArcanaEngine()
            if "monte_carlo" in query:
                data = arcana.simulate_vector_interference(500)
            else:
                data = arcana.resolve_action("Tactical Surge", stat_bonus=2)
            self._send_json(data)
            return

        elif path == "/api/codex":
            mgr = CodexManager(BASE_DIR)
            if "compile" in query:
                out = mgr.build_notebooklm_corpus()
                data = {"status": "SUCCESS", "path": out}
            else:
                data = {"books": mgr.list_books()}
            self._send_json(data)
            return

        elif path == "/api/combat":
            camp = CampaignEngine(os.path.join(BASE_DIR, "strata", "campaign.db"))
            actor = random.choice(["Kiri Vespera", "Aurelia-9"])
            turn = camp.record_combat_turn(actor, "Harmonic Resonance Strike", stat_mod=2)
            self._send_json(turn)
            return

        # 7. Master RPG API Endpoints
        elif path == "/api/rpg/state":
            self._send_json(GAME_LOOP.get_full_game_state())
            return

        elif path == "/api/rpg/chamber":
            chamber_id = int(query.get("id", [1])[0])
            self._send_json(CHAMBER_GEN.export_chamber_json(chamber_id))
            return

        elif path == "/api/rpg/origins":
            self._send_json({k: v.__dict__ for k, v in CHAR_CREATOR.origins.items()})
            return

        elif path == "/api/rpg/archetypes":
            self._send_json({k: v.__dict__ for k, v in CHAR_CREATOR.archetypes.items()})
            return

        elif path == "/api/rpg/starter_relics":
            self._send_json({k: v.__dict__ for k, v in CHAR_CREATOR.relics.items()})
            return

        elif path == "/api/rpg/character_create":
            name = query.get("name", ["Kiri Vespera"])[0]
            origin = query.get("origin", ["LITHIC_SCION"])[0]
            archetype = query.get("archetype", ["VOID_WALKER"])[0]
            spectrum = query.get("spectrum", ["Gold"])[0]
            relic = query.get("relic", ["OBJ_TRIKEY_LEAD"])[0]

            res = CHAR_CREATOR.create_character(name, origin, archetype, spectrum, relic)
            GAME_LOOP.start_new_game(name, res["archetype"])
            self._send_json(res)
            return

                elif path == "/api/rpg/interact":
            query_dict = {k: v[0] for k, v in query_components.items()} if "query_components" in locals() else {}
            if not query_dict and "?" in self.path:
                import urllib.parse
                qs = self.path.split("?", 1)[1]
                query_dict = {k: v[0] for k, v in urllib.parse.parse_qs(qs).items()}
            res = GAME_LOOP.handle_interaction(query_dict) if hasattr(GAME_LOOP, "handle_interaction") else {"status": "SUCCESS", "action": "INTERACT"}
            self._send_json(res)
            return
        elif path == "/api/rpg/move":
            x = int(query.get("x", [1])[0])
            y = int(query.get("y", [1])[0])
            self._send_json(GAME_LOOP.player_move(x, y))
            return

        elif path == "/api/rpg/attack":
            target_uid = query.get("target_uid", ["enemy_01"])[0]
            action_name = query.get("action", ["Resonance Strike"])[0]
            spectrum_str = query.get("spectrum", ["Gold"])[0]
            try:
                spectrum = EnemySpectrum(spectrum_str)
            except ValueError:
                spectrum = EnemySpectrum.GOLD
            self._send_json(GAME_LOOP.player_attack(target_uid, action_name, attack_spectrum=spectrum))
            return

        elif path == "/api/rpg/end_turn":
            self._send_json(GAME_LOOP.end_player_turn())
            return

        elif path == "/api/rpg/dialogue":
            tree = query.get("tree", ["AURELIA_GENESIS"])[0]
            node_id = query.get("node", ["start"])[0]
            node = GAME_LOOP.dialogue.get_node(tree, node_id)
            if node:
                self._send_json({
                    "node": {
                        "node_id": node.node_id,
                        "speaker": node.speaker,
                        "speaker_spectrum": node.speaker_spectrum,
                        "text": node.text,
                        "options": [opt.__dict__ for opt in node.options]
                    }
                })
            else:
                self._send_json({"error": "Node not found"})
            return

        elif path == "/api/rpg/dialogue_choice":
            tree = query.get("tree", ["AURELIA_GENESIS"])[0]
            node_id = query.get("node", ["start"])[0]
            choice_idx = int(query.get("choice", [0])[0])
            self._send_json(GAME_LOOP.dialogue.select_option(tree, node_id, choice_idx))
            return

        elif path == "/api/rpg/talent":
            char_name = query.get("character", ["Kiri Vespera"])[0]
            talent_id = query.get("talent", ["T_VOID_SURGE"])[0]
            archetype = query.get("archetype", ["Void Walker"])[0]
            self._send_json(GAME_LOOP.progression.unlock_talent(char_name, talent_id, archetype))
            return

        elif path == "/api/rpg/craft":
            recipe_id = query.get("recipe", ["RECIPE_HGASE_PRISM"])[0]
            owner_id = int(query.get("owner", [1])[0])
            self._send_json(GAME_LOOP.progression.craft_relic(recipe_id, owner_id))
            return

        elif path == "/api/rpg/save_slots":
            self._send_json({"slots": SAVE_MGR.list_slots()})
            return

        elif path == "/api/rpg/save":
            slot_id = int(query.get("slot", [1])[0])
            slot_name = query.get("name", ["Manual Checkpoint"])[0]
            self._send_json(SAVE_MGR.save_slot(slot_id, slot_name, GAME_LOOP.get_full_game_state()))
            return

        elif path == "/api/rpg/load":
            slot_id = int(query.get("slot", [1])[0])
            self._send_json(SAVE_MGR.load_slot(slot_id) or {"error": "Slot is empty"})
            return

        elif path == "/api/rpg/export_chronicle":
            out_file = SAVE_MGR.export_chronicle_to_markdown()
            self._send_json({"status": "SUCCESS", "chronicle_file": out_file})
            return

        # Fallback static file serving
        return super().do_GET()

    def _send_json(self, data: dict):
        body = json.dumps(data, indent=2, default=lambda o: getattr(o, "__dict__", str(o))).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

def run_server(port: int = 5050):
    socketserver.TCPServer.allow_reuse_address = True
    httpd = None
    target_port = port
    for p in range(port, port + 10):
        try:
            server_address = ("", p)
            httpd = socketserver.TCPServer(server_address, CathedralHTTPHandler)
            target_port = p
            break
        except OSError as e:
            if e.errno in (48, 98):  # Address in use
                continue
            raise e

    if not httpd:
        print(f"[ERROR] Could not bind server to ports {port}-{port+9}. An instance is likely already running.")
        return

    print()
    print("==================================================")
    print(" CATHEDRAL-ENGINE :: PRODUCTION WEB ALTAR ONLINE  ")
    print("==================================================")
    print(f"  [+] Web Altar UI:    http://localhost:{target_port}/")
    print(f"  [+] Master Atlas:    http://localhost:{target_port}/atlas")
    print(f"  [+] Playable RPG:    http://localhost:{target_port}/rpg")
    print(f"  [+] Cosmo Catch:     http://localhost:{target_port}/arcade")
    print(f"  [+] 3D Dashboard:    http://localhost:{target_port}/dashboard")
    print(f"  [+] REST API:        http://localhost:{target_port}/api/status")
    print(f"  [+] QGrav API:       http://localhost:{target_port}/api/qgrav")
    print("==================================================")
    print()
    
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print()
        print("[SERVER] Web Altar shutting down gracefully.")
        httpd.server_close()

if __name__ == "__main__":
    port = 5050
    if len(sys.argv) > 1:
        port = int(sys.argv[1])
    run_server(port)

# --- Top-Level CLI / Utility Exports ---
def init_db():
    """Top-level proxy to initialize CampaignEngine database."""
    engine = CampaignEngine()
    return engine.init_db()
